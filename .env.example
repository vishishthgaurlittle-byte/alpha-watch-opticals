# Copy to .env.local and fill in (never commit .env.local)

# Insforge Backend
INFORGE_PROJECT_ID=your-project-id
INFORGE_API_KEY=your-api-key
INFORGE_URL=https://your-project.ap-southeast.insforge.app/
INFORGE_VERSION=v2.3.1

# Site
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# GitHub (server-side only)
GITHUB_TOKEN=your-github-token

# Google OAuth
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Demo admin
ADMIN_SEED_EMAIL=admin@alpha.com
ADMIN_SEED_PASSWORD=admin123

# UPI
NEXT_PUBLIC_UPI_ID=alphawatch@upi
